# Root Environment Variables Reference
# Refer to FRA_Backend/.env and FRA_Frontend/.env for directory-specific configurations

# Backend (.env located in FRA_Backend/.env)
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGOOSE_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
DB_NAME=food_recipe_db
JWT_SECRET=supersecret_foodrecipe_jwt_key_2026_secure
JWT_EXPIRES_IN=7d
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend (.env located in FRA_Frontend/.env)
VITE_API_URL=http://localhost:5050/api
