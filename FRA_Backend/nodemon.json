{
  "restartable": "rs",
  "ignore": [
    "node_modules/**",
    "uploads/**",
    ".git/**",
    "*.log"
  ],
  "watch": [
    "server.js",
    "controllers",
    "models",
    "routes",
    "middleware",
    "config",
    "utils",
    ".env"
  ],
  "ext": "js,json",
  "delay": 500,
  "env": {
    "NODE_ENV": "development"
  }
}
